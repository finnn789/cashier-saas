{
  "info": {
    "name": "F&B Catalog Controller",
    "description": "Postman Collection untuk FnbCatalogController pada Cashier SaaS (KedaiMbo). Mencakup 14 endpoint manajemen Kategori, Produk, Kelompok Pilihan (Option Groups), dan Pilihan (Options).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "outletId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "optionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Categories",
      "description": "Endpoints untuk pengelolaan kategori menu F&B",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Makanan Utama\",\n  \"displayOrder\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/outlets/{{outletId}}/fnb/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "outlets",
                "{{outletId}}",
                "fnb",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has created category ID\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    if (res.data && res.data.id) {",
                  "        pm.collectionVariables.set(\"categoryId\", res.data.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cashier/outlets/{{outletId}}/fnb/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "cashier",
                "outlets",
                "{{outletId}}",
                "fnb",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains categories list\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data).to.be.an(\"array\");",
                  "});"
