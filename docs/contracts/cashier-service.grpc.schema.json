{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cashier-saas.local/contracts/cashier-service.grpc.schema.json",
  "title": "CashierService gRPC JSON mapping (cashier.v1)",
  "description": "JSON form of the messages in src/main/proto/cashier_service.proto, for testing with grpcurl or Postman. Owner-only RPCs (GetSalesSummary, GetRestockSuggestions, GetAnomalies) are read-only and need an OWNERMERCHANT user_id; their money and quantity fields are plain decimal strings without a fixed scale (see $defs/decimal). Metadata required on every call: x-internal-service-key = CASHIER_GRPC_SERVICE_KEY. proto3 JSON rules: money is a decimal string with 2 decimals (BigDecimal plain string, e.g. \"12500.50\"), never a number; int64 is a string in responses; fields holding their default value (empty string, 0, false) may be omitted in responses; responses use lowerCamelCase names (tenantId) while requests accept both snake_case and lowerCamelCase.",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "description": "Tenant UUID. Must be an existing, active tenant with F&B enabled, otherwise PERMISSION_DENIED."
    },
    "money": {
      "type": "string",
      "pattern": "^-?[0-9]+[.][0-9]{2}$",
      "description": "Decimal amount as a plain string with exactly 2 decimals, e.g. 12500.50. Never a float or an integer."
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Staff user UUID (the Java user id). Must be an ACTIVE user with an active membership in tenant_id and access to at least one active outlet; results are limited to those outlets. Blank or malformed is INVALID_ARGUMENT; any other failure is PERMISSION_DENIED with the same message as a rejected tenant."
    },
    "GetCatalogItemRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "user_id"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/uuid" },
        "user_id": { "$ref": "#/$defs/userId" },
        "query": {
          "type": "string",
          "description": "Optional. Case-insensitive match on product name or category name. Blank means no filter."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "Optional. 0 or negative uses the default (10); values above the maximum (50) are clamped."
        }
      }
    },
    "CatalogItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "priceAmount": {
          "allOf": [{ "$ref": "#/$defs/money" }],
          "description": "Wire name is price_amount. Replaces the removed numeric field price (field 3)."
        },
        "isAvailable": {
          "type": "boolean",
          "description": "Wire name is is_available. Always true in practice: unavailable and archived products are filtered out."
        },
        "category": { "type": "string" }
      }
    },
    "GetCatalogItemResponse": {
      "type": "object",
      "properties": {
        "tenantId": { "$ref": "#/$defs/uuid" },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/CatalogItem" }
        }
      }
    },
    "GetOrderStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "user_id", "order_number"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/uuid" },
        "user_id": { "$ref": "#/$defs/userId" },
        "order_number": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Order number, trimmed by the server. Looked up only inside the given tenant; an order of another tenant, or of an outlet the user cannot access, returns NOT_FOUND."
        }
      }
    },
    "GetOrderStatusResponse": {
      "type": "object",
      "properties": {
        "tenantId": { "$ref": "#/$defs/uuid" },
        "orderNumber": { "type": "string" },
        "status": {
          "type": "string",
          "description": "Order status enum name from the backend: OPEN (belum dibayar), COMPLETED (selesai, sudah dibayar) or CANCELLED (dibatalkan)."
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment status enum name from the backend."
        },
        "total": {
          "allOf": [{ "$ref": "#/$defs/money" }],
          "description": "Replaces the removed numeric field total_amount (field 5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 instant in UTC."
        }
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+([.][0-9]+)?$",
      "description": "Decimal amount or quantity as a plain string (BigDecimal toPlainString, scale not fixed: money may be \"0\" or \"125000.50\", quantities have up to 3 decimals), never a number."
    },
    "ownerUserId": {
      "type": "string",
      "format": "uuid",
      "description": "Staff user UUID of an ACTIVE membership with role OWNERMERCHANT in tenant_id. Blank or malformed is INVALID_ARGUMENT. A cashier, an unknown user, a deactivated membership or a user without outlet access gets PERMISSION_DENIED with the same message as a rejected tenant (no existence evidence); this check runs before argument validation. Results are limited to the owner's active outlets."
    },
    "GetSalesSummaryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "user_id",
        "start_date",
        "end_date"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/uuid"
        },
        "user_id": {
          "$ref": "#/$defs/ownerUserId"
        },
        "start_date": {
          "allOf": [
            {
              "type": "string",
              "format": "date"
            }
          ],
          "description": "ISO date yyyy-MM-dd in each outlet's time zone, inclusive. Required."
        },
        "end_date": {
          "allOf": [
            {
              "type": "string",
              "format": "date"
            }
          ],
          "description": "ISO date, inclusive, must be >= start_date; the range must be shorter than 366 days. Violations are INVALID_ARGUMENT."
        }
      }
    },
    "LabelTotal": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "description": "Payment method enum name."
        },
        "label": {
          "type": "string",
          "description": "Owner-defined payment label snapshot (Tunai, QRIS, Transfer, Debit, ...)."
        },
        "count": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        },
        "netSales": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "ProductTotal": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        },
        "grossSales": {
          "$ref": "#/$defs/decimal"
        },
        "costOfGoodsSold": {
          "$ref": "#/$defs/decimal"
        },
        "grossProfit": {
          "$ref": "#/$defs/decimal"
        },
        "itemsWithoutCost": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        }
      }
    },
    "OutletSalesSummary": {
      "type": "object",
      "description": "Sales of one outlet over the range, from paid, non-cancelled, non-refunded transactions only. int64 fields are strings in JSON.",
      "properties": {
        "outletId": {
          "type": "string",
          "format": "uuid"
        },
        "outletName": {
          "type": "string"
        },
        "timeZone": {
          "type": "string",
          "description": "IANA zone of the outlet."
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "transactionCount": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        },
        "grossSales": {
          "$ref": "#/$defs/decimal"
        },
        "discountAmount": {
          "$ref": "#/$defs/decimal"
        },
        "netSales": {
          "$ref": "#/$defs/decimal"
        },
        "total": {
          "$ref": "#/$defs/decimal"
        },
        "taxAmount": {
          "$ref": "#/$defs/decimal"
        },
        "serviceChargeAmount": {
          "$ref": "#/$defs/decimal"
        },
        "costOfGoodsSold": {
          "$ref": "#/$defs/decimal"
        },
        "grossProfit": {
          "$ref": "#/$defs/decimal"
        },
        "itemsWithoutCost": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        },
        "refundCount": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        },
        "refundAmount": {
          "$ref": "#/$defs/decimal"
        },
        "cancellationCount": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        },
        "discountedOrderCount": {
          "type": "string",
          "description": "int64. Paid, non-cancelled orders with discount > 0."
        },
        "expensesTotal": {
          "allOf": [
            {
              "$ref": "#/$defs/decimal"
            }
          ],
          "description": "Cash expenses recorded in the range."
        },
        "cashDifferenceTotal": {
          "allOf": [
            {
              "$ref": "#/$defs/decimal"
            }
          ],
          "description": "Signed sum of cash differences of CLOSED shifts whose business date (outlet-local date of openedAt) is in the range."
        },
        "closedShiftCount": {
          "type": "string",
          "description": "int64 (a string in JSON)."
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LabelTotal"
          }
        },
        "topProducts": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/ProductTotal"
          }
        }
      }
    },
    "GetSalesSummaryResponse": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "outlets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutletSalesSummary"
          }
        }
      }
    },
    "GetRestockSuggestionsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "user_id"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/uuid"
        },
        "user_id": {
          "$ref": "#/$defs/ownerUserId"
        }
      }
    },
    "RestockSuggestion": {
      "type": "object",
      "properties": {
        "inventoryItemId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "quantityOnHand": {
          "$ref": "#/$defs/decimal"
        },
        "reorderLevel": {
          "$ref": "#/$defs/decimal"
        },
        "averageDailyUsage": {
          "allOf": [
            {
              "$ref": "#/$defs/decimal"
            }
          ],
          "description": "Usage over the last 14 x 24 h (SALE, SALE_REVERSAL and WASTE movements) divided by 14, scale 3."
        },
        "suggestedQuantity": {
          "allOf": [
            {
              "$ref": "#/$defs/decimal"
            }
          ],
          "description": "max(0, averageDailyUsage x 7 + reorderLevel - quantityOnHand), scale 3."
        },
        "stockStatus": {
          "type": "string",
          "enum": [
            "NEGATIVE",
            "OUT",
            "LOW",
            "OK"
          ]
        }
      }
    },
    "OutletRestock": {
      "type": "object",
      "description": "Active ingredients with suggestedQuantity > 0 or status NEGATIVE/OUT/LOW, ordered NEGATIVE, OUT, LOW, OK then name.",
      "properties": {
        "outletId": {
          "type": "string",
          "format": "uuid"
        },
        "outletName": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RestockSuggestion"
          }
        }
      }
    },
    "GetRestockSuggestionsResponse": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "outlets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutletRestock"
          }
        }
      }
    },
    "GetAnomaliesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "user_id",
        "date"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/uuid"
        },
        "user_id": {
          "$ref": "#/$defs/ownerUserId"
        },
        "date": {
          "allOf": [
            {
              "type": "string",
              "format": "date"
            }
          ],
          "description": "ISO date yyyy-MM-dd, the outlet-local day to evaluate. Required; blank or malformed is INVALID_ARGUMENT."
        }
      }
    },
    "CashierAnomaly": {
      "type": "object",
      "description": "Rule: the day's value > 2 x the cashier's daily average over the previous 30 days AND at least the minimum.",
      "properties": {
        "staffUserId": {
          "type": "string",
          "format": "uuid"
        },
        "fullName": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "CANCELLATIONS",
            "DISCOUNTS",
            "CASH_DIFFERENCE"
          ],
          "description": "Minimums: CANCELLATIONS >= 3, DISCOUNTS (discounted orders) >= 3, CASH_DIFFERENCE |difference| >= 20000."
        },
        "value": {
          "allOf": [
            {
              "$ref": "#/$defs/decimal"
            }
          ],
          "description": "A count for CANCELLATIONS and DISCOUNTS; the sum of absolute cash differences (money) for CASH_DIFFERENCE."
        },
        "baselineDailyAverage": {
          "allOf": [
            {
              "$ref": "#/$defs/decimal"
            }
          ],
          "description": "Sum over the previous 30 days divided by 30, scale 2."
        }
      }
    },
    "OutletAnomalies": {
      "type": "object",
      "description": "CASHIER members only; owners are never evaluated.",
      "properties": {
        "outletId": {
          "type": "string",
          "format": "uuid"
        },
        "outletName": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "anomalies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CashierAnomaly"
          }
        }
      }
    },
    "GetAnomaliesResponse": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "outlets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutletAnomalies"
          }
        }
      }
    }
  },
  "x-service": "cashier.v1.CashierService",
  "x-methods": {
    "GetCatalogItem": {
      "request": { "$ref": "#/$defs/GetCatalogItemRequest" },
      "response": { "$ref": "#/$defs/GetCatalogItemResponse" },
      "errors": ["UNAUTHENTICATED", "RESOURCE_EXHAUSTED", "INVALID_ARGUMENT", "PERMISSION_DENIED", "INTERNAL"]
    },
    "GetOrderStatus": {
      "request": { "$ref": "#/$defs/GetOrderStatusRequest" },
      "response": { "$ref": "#/$defs/GetOrderStatusResponse" },
      "errors": ["UNAUTHENTICATED", "RESOURCE_EXHAUSTED", "INVALID_ARGUMENT", "PERMISSION_DENIED", "NOT_FOUND", "INTERNAL"]
    },
    "GetSalesSummary": {
      "request": {
        "$ref": "#/$defs/GetSalesSummaryRequest"
      },
      "response": {
        "$ref": "#/$defs/GetSalesSummaryResponse"
      },
      "errors": [
        "UNAUTHENTICATED",
        "RESOURCE_EXHAUSTED",
        "INVALID_ARGUMENT",
        "PERMISSION_DENIED",
        "INTERNAL"
      ],
      "x-ownerOnly": true,
      "x-readOnly": true
    },
    "GetRestockSuggestions": {
      "request": {
        "$ref": "#/$defs/GetRestockSuggestionsRequest"
      },
      "response": {
        "$ref": "#/$defs/GetRestockSuggestionsResponse"
      },
      "errors": [
        "UNAUTHENTICATED",
        "RESOURCE_EXHAUSTED",
        "INVALID_ARGUMENT",
        "PERMISSION_DENIED",
        "INTERNAL"
      ],
      "x-ownerOnly": true,
      "x-readOnly": true
    },
    "GetAnomalies": {
      "request": {
        "$ref": "#/$defs/GetAnomaliesRequest"
      },
      "response": {
        "$ref": "#/$defs/GetAnomaliesResponse"
      },
      "errors": [
        "UNAUTHENTICATED",
        "RESOURCE_EXHAUSTED",
        "INVALID_ARGUMENT",
        "PERMISSION_DENIED",
        "INTERNAL"
      ],
      "x-ownerOnly": true,
      "x-readOnly": true
    }
  },
  "examples": [
    {
      "method": "GetCatalogItem",
      "request": { "tenant_id": "00000000-0000-4000-8000-0000000000b1", "user_id": "00000000-0000-4000-8000-0000000000c1", "query": "kopi", "limit": 5 },
      "response": {
        "tenantId": "00000000-0000-4000-8000-0000000000b1",
        "items": [
          { "id": "5d1c3a52-7f0e-4f0b-9a52-0d9b4a0c1e11", "name": "Kopi Susu", "isAvailable": true, "category": "Minuman", "priceAmount": "18000.00" }
        ]
      }
    },
    {
      "method": "GetOrderStatus",
      "request": { "tenant_id": "00000000-0000-4000-8000-0000000000b1", "user_id": "00000000-0000-4000-8000-0000000000c1", "order_number": "ORD-20261022-001" },
      "response": {
        "tenantId": "00000000-0000-4000-8000-0000000000b1",
        "orderNumber": "ORD-20261022-001",
