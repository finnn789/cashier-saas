    {
      "method": "GetSalesSummary",
      "request": {
        "tenant_id": "00000000-0000-4000-8000-0000000000b1",
        "user_id": "00000000-0000-4000-8000-0000000000c1",
        "start_date": "2026-11-14",
        "end_date": "2026-11-14"
      },
      "response": {
