
CASHIER_JWT_SECRET_B64=


# Shared secret for gRPC callers (Ai-services). Backend and ai-services must use the same value.
# At least 16 random characters; never commit the real value. Generate: openssl rand -base64 32
CASHIER_GRPC_SERVICE_KEY=

# Shared secret for the Ai-services internal member API (X-Internal-Service-Key header, backend -> ai-services).
# Must differ from CASHIER_GRPC_SERVICE_KEY; at least 16 random characters. Required by compose.
AI_INTERNAL_API_KEY=

# Backend -> Ai-services base URL used for staff sync. Compose defaults to http://ai-services:8001 when blank.
# Outside Docker, leave blank to disable sync or set e.g. http://localhost:8001.
AI_SERVICE_BASE_URL=


POSTGRES_HOST_PORT=5432
BACKEND_HTTP_PORT=8080
AI_HTTP_PORT=8001
# JWT claims validated by the backend.
CASHIER_JWT_ISSUER=cashier-saas
CASHIER_JWT_AUDIENCE=cashier-saas-api


# Development fallback only: used by ai-services when no verified Telegram tenant is available.
# It never overrides a tenant resolved from a verified staff membership.
AI_TENANT_ID=00000000-0000-4000-8000-0000000000b1

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

OPENROUTER_API_KEY=
AI_MODEL=


# CASHIER_DB_URL=jdbc:postgresql://localhost:5432/cashier_saas
# CASHIER_DB_USERNAME=cashier
# CASHIER_DB_PASSWORD=cashier_demo
# CASHIER_DB_POOL_MAX_SIZE=10
# CASHIER_REFRESH_COOKIE_SECURE=false
# gRPC tenant access is a database check: a tenant is served when it exists and is active (no env allowlist).
