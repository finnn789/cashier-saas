# Copy to .env (never commit .env). Used by `docker compose` and by local `mvnw spring-boot:run`.

# ---------- Required ----------
# Standard Base64 of >= 32 random bytes. Generate one:
#   bash:        openssl rand -base64 32
#   PowerShell:  [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
CASHIER_JWT_SECRET_B64=

# ---------- Docker Compose (all optional) ----------
# Password of the `cashier` PostgreSQL role (used by postgres, backend and ai-services).
POSTGRES_PASSWORD=cashier_demo
# Host ports.
POSTGRES_HOST_PORT=5432
BACKEND_HTTP_PORT=8080
BACKEND_GRPC_PORT=9090
AI_HTTP_PORT=8001
# JWT claims validated by the backend.
CASHIER_JWT_ISSUER=cashier-saas
CASHIER_JWT_AUDIENCE=cashier-saas-api

# ---------- AI service (only with `docker compose --profile ai up`) ----------
# Tenant UUID of the AI registry; default is the demo tenant "Kopi Demo".
AI_TENANT_ID=00000000-0000-4000-8000-0000000000b1
# Telegram BotFather token and optional comma-separated allowed numeric user IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# OpenRouter key and exact model id (>= 32768 context tokens).
OPENROUTER_API_KEY=
AI_MODEL=

# ---------- Local run without Docker (mvnw spring-boot:run) ----------
# Ignored by docker compose; the backend reads them via spring.config.import=file:.env.
# CASHIER_DB_URL=jdbc:postgresql://localhost:5432/cashier_saas
# CASHIER_DB_USERNAME=cashier
# CASHIER_DB_PASSWORD=cashier_demo
# CASHIER_DB_POOL_MAX_SIZE=10
# CASHIER_REFRESH_COOKIE_SECURE=false
