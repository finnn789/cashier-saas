# Copy this file to .env for local tooling, or configure these values as
# environment variables in your IDE/run configuration. Do not commit .env.

# PostgreSQL
CASHIER_DB_URL=jdbc:postgresql://localhost:5432/cashier_saas
CASHIER_DB_USERNAME=postgres
CASHIER_DB_PASSWORD=change-me
CASHIER_DB_POOL_MAX_SIZE=10

# JWT
CASHIER_JWT_ISSUER=cashier-saas
CASHIER_JWT_AUDIENCE=cashier-saas-api
# Must be standard Base64 and decode to at least 32 random bytes.
# PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
CASHIER_JWT_SECRET_B64=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_RANDOM_SECRET
