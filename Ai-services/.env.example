# Telegram BotFather token. Keep the real value in .env.
TELEGRAM_BOT_TOKEN=

# OpenRouter API key; keep the real value in .env.
OPENROUTER_API_KEY=
# Exact provider/model ID; use a model with at least 32768 context tokens.
AI_MODEL=
# Optional positive Telegram user IDs separated by commas; blank allows private human users.
TELEGRAM_ALLOWED_USER_IDS=

# Dedicated PostgreSQL AI database URL; no default credentials or database.
DATABASE_URL=
# Required server-owned UUID for the local AI tenant registry. Not Cashier authorization.
AI_TENANT_ID=

# Shared secret sent to the Cashier backend gRPC as metadata header x-internal-service-key.
# Must equal the backend CASHIER_GRPC_SERVICE_KEY; at least 16 random characters, never commit the real value.
# Generate one: openssl rand -base64 32
CASHIER_GRPC_SERVICE_KEY=
