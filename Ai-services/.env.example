# Telegram BotFather token. Keep the real value in .env.
TELEGRAM_BOT_TOKEN=

# OpenRouter API key; keep the real value in .env.
OPENROUTER_API_KEY=
# Exact provider/model ID; use a model with at least 32768 context tokens.
AI_MODEL=
# Optional positive Telegram user IDs separated by commas; blank allows private human users.
TELEGRAM_ALLOWED_USER_IDS=

# Dedicated PostgreSQL AI database URL; no default credentials or database.
DATABASE_URL=
# Development fallback only (in progress): used when no verified Telegram tenant is available.
# It never overrides a tenant resolved from a verified staff membership. Leave blank in production.
AI_TENANT_ID=

# Shared secret sent to the Cashier backend gRPC as metadata header x-internal-service-key.
# Must equal the backend CASHIER_GRPC_SERVICE_KEY; at least 16 random characters, never commit the real value.
# Generate one: openssl rand -base64 32
CASHIER_GRPC_SERVICE_KEY=

# Shared secret for the internal member API (PUT /api/v1/internal/tenants/...), sent by the Cashier backend
# as header X-Internal-Service-Key. Must equal the backend AI_INTERNAL_API_KEY and differ from
# CASHIER_GRPC_SERVICE_KEY; at least 16 random characters, never commit the real value.
# Generate one: openssl rand -base64 32
AI_INTERNAL_API_KEY=

# Logging: JSON lines on stdout; optional rotating file (always JSON). See README "Logging".
# LOG_LEVEL=INFO
# LOG_FORMAT=json            # json | text (stdout only)
# LOG_FILE_ENABLED=false     # true also writes LOG_DIR/ai-services.log
# LOG_DIR=logs
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
